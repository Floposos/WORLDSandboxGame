# Optionale Keys für bessere Grafik. Ohne Keys läuft GlobeBox im Open-Data-Modus.
# Kopiere diese Datei nach .env.local und trage deine Keys ein. .env.local wird nie committet.
# Achtung: Vite baut VITE_*-Variablen in das Bundle ein. Der GitHub-Pages-Build setzt sie nie.
VITE_GOOGLE_MAPS_KEY=
VITE_CESIUM_ION_TOKEN=
