{
  "name": "globebox",
  "version": "0.0.0",
  "private": true,
  "description": "GlobeBox – browserbasiertes Sandbox-Spiel auf einem 3D-Erdglobus",
  "license": "MIT",
  "author": "GlobeBox contributors",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Floposos/WORLDSandboxGame.git"
  },
  "bugs": {
    "url": "https://github.com/Floposos/WORLDSandboxGame/issues"
  },
  "homepage": "https://github.com/Floposos/WORLDSandboxGame#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
